generator client {
  // 在源代码目录之外生成带类型的客户端，使应用导入路径清晰且不会混入手写代码。
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // 当前应用使用 SQLite。运行时建表和兼容升级仍由 database.ts 负责；本文件用于
  // Prisma 类型与发布时 schema diff，必须由 db:check 和初始化回归持续防止两者漂移。
  provider = "sqlite"
}

model AppUser {
  // 第一个账号是管理员；后续排课账号共享时间表访问权限，但不能管理账号。
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  isAdmin      Boolean  @default(false) @map("is_admin")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  // 管理员启停账号时以这个公开版本作比较，防止两个浏览器静默覆盖彼此的状态。
  revision     Int      @default(1)

  sessions AuthSession[]

  @@map("app_users")
}

model AuthSession {
  // 数据库只保存随机 Cookie 令牌的摘要；每个登录会话在 12 小时后过期。
  tokenHash String   @id @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Teacher {
  // 一位教师可以关联导入的教学分配、生成的课程班次以及个人不可用时段。
  id                 String   @id @default(uuid())
  name               String   @unique
  staffType          String   @default("FT") @map("staff_type")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  revision           Int      @default(1)
  // 导入来源键保存 Excel 中首次认领的 Lecturer 标识。人工改名不会改变它，
  // 因而下一次导入仍会更新原教师，而不会因显示名称不同建立重复记录。
  teachingMembersKey String?  @unique @map("teaching_members_key")

  allocations        TeachingAllocation[]
  sections           CourseSection[] @relation("AssignedSectionTeacher")
  allocationSections CourseSection[] @relation("ImportedAllocationTeacher")
  unavailable        TeacherUnavailableWindow[]

  @@map("teachers")
}

model StudentGroup {
  // 一个学生班级代表共同上课的同一组学生，其时间表发生重叠时必须提示冲突。
  id        String   @id @default(uuid())
  code      String
  year      Int
  program   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  // 浏览器提交打开表单时看到的版本，防止旧表单覆盖另一账号刚保存的资料。
  revision  Int      @default(1)

  sections SectionStudentGroup[]

  // 同一个班级编号会在不同年级重复使用；只有“年级 + 编号”组合必须唯一。
  @@unique([year, code], map: "student_groups_year_code_key")
  @@map("student_groups")
}

model Room {
  // 教室设施用于匹配课程要求，Block 楼栋信息则用于连续课程跨楼提醒。
  id                String   @id @default(uuid())
  code              String   @unique
  block             String?
  capacity          Int
  hasMultiProjector Boolean  @default(false) @map("has_multi_projector")
  isLab             Boolean  @default(false) @map("is_lab")
  isSmartClassroom  Boolean  @default(false) @map("is_smart_classroom")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  // 容量、设施、地址和启用状态共享同一个版本，因为它们都影响排课候选或警告。
  revision          Int      @default(1)

  lessons ScheduledLesson[]

  @@index([isActive, code])
  @@map("rooms")
}

model Course {
  // 课程保存所有班次共用的教学要求，具体的 LEAD_01 等班次在其下生成。
  id                         String   @id @default(uuid())
  code                       String   @unique
  catalog                    String?
  durationHours              Int?     @map("duration_hours")
  sessionsPerWeek            Int      @default(1) @map("sessions_per_week")
  primaryYear                Int?     @map("primary_year")
  minimumRoomCapacity        Int?     @map("minimum_room_capacity")
  requiresLab                Boolean  @default(false) @map("requires_lab")
  requiresMultiProjector     Boolean  @default(false) @map("requires_multi_projector")
  requiresSmartClassroom     Boolean  @default(false) @map("requires_smart_classroom")
  separateSectionsAcrossDays Boolean  @default(false) @map("separate_sections_across_days")
  // 保留旧版快捷周次字段，用于兼容较早版本生成的本地备份。
  weekPattern                String   @default("ALL") @map("week_pattern")
  // 开始周和结束周都为空表示全学期；否则两个正整数共同定义实际上课周次范围。
  weekStart                  Int?     @map("week_start")
  weekEnd                    Int?     @map("week_end")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at")
  // 放在表尾与旧数据库 ALTER TABLE 的追加位置一致，完整系统备份可在同版本新库间恢复。
  revision                   Int      @default(1)

  allocations TeachingAllocation[]
  sections    CourseSection[]

  @@index([primaryYear], map: "courses_primary_year_idx")
  @@map("courses")
}

model TeachingAllocation {
  // 此表记录教学分配中某位教师预计承担某门课程的班次数量。
  id                 String @id @default(uuid())
  assignedGroupCount Int    @map("assigned_group_count")

  courseId  String  @map("course_id")
  teacherId String  @map("teacher_id")
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([courseId, teacherId])
  @@index([teacherId], map: "teaching_allocations_teacher_id_idx")
  @@map("teaching_allocations")
}

model CourseSection {
  // 课程班次是可拖放的基本单位，例如 LEAD_01，并且只分配一位任课教师。
  id       String @id @default(uuid())
  sequence Int
  revision Int    @default(1)

  courseId            String   @map("course_id")
  teacherId           String?  @map("teacher_id")
  allocationTeacherId String?  @map("allocation_teacher_id")
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher             Teacher? @relation("AssignedSectionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  allocationTeacher   Teacher? @relation("ImportedAllocationTeacher", fields: [allocationTeacherId], references: [id], onDelete: SetNull)

  studentGroups SectionStudentGroup[]
  lessons       ScheduledLesson[]

  @@unique([courseId, sequence])
  @@index([teacherId], map: "course_sections_teacher_id_idx")
  @@map("course_sections")
}

model SectionStudentGroup {
  // 此关联表让同一课程班次既能连接普通单年级班级，也能连接多个跨年级班级。
  sectionId      String @map("section_id")
  studentGroupId String @map("student_group_id")

  section      CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup  @relation(fields: [studentGroupId], references: [id], onDelete: Cascade)

  @@id([sectionId, studentGroupId])
  @@index([studentGroupId, sectionId], map: "section_student_groups_student_group_id_section_id_idx")
  @@map("section_student_groups")
}

model ScheduledLesson {
  // 同一班次每周可以上多次课，而且每次课允许使用不同教室。
  id            String @id @default(uuid())
  occurrence    Int    @default(1)
  dayOfWeek     Int    @map("day_of_week")
  startHour     Int    @map("start_hour")
  durationHours Int    @map("duration_hours")
  revision      Int    @default(1)
  warningsJson  String @default("[]") @map("warnings_json")

  sectionId String        @map("section_id")
  roomId    String?       @map("room_id")
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  room      Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([sectionId, occurrence])
  @@index([roomId, dayOfWeek, startHour])
  @@index([dayOfWeek, startHour])
  @@index([sectionId, dayOfWeek, startHour])
  @@map("scheduled_lessons")
}

model TeacherUnavailableWindow {
  // 给教师安排任何课程时，系统都会检查其严格不可用时段并产生警告。
  id        String @id @default(uuid())
  dayOfWeek Int    @map("day_of_week")
  startHour Int    @map("start_hour")
  endHour   Int    @map("end_hour")

  teacherId String  @map("teacher_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, dayOfWeek, startHour, endHour], map: "teacher_unavailable_windows_teacher_id_day_of_week_start_hour_end_hour_key")
  @@map("teacher_unavailable_windows")
}

model YearBlockedWindow {
  // 年级禁排时段用于表达“整个星期三不上课”等适用于该年级所有学生的限制。
  id        String @id @default(uuid())
  year      Int
  dayOfWeek Int    @map("day_of_week")
  startHour Int    @map("start_hour")
  endHour   Int    @map("end_hour")

  @@unique([year, dayOfWeek, startHour, endHour], map: "year_blocked_windows_year_day_of_week_start_hour_end_hour_key")
  @@map("year_blocked_windows")
}

model RuleSetting {
  // 规则功能开关让未来新增或调整的政策可以启用、停用，而无需删除任何排课数据。
  key       String  @id @map("rule_key")
  isEnabled Boolean @default(true) @map("is_enabled")

  @@map("rule_settings")
}

model ScheduleBackup {
  // 开始新排课周期并替换旧数据前，系统会保存一份序列化紧急快照。
  id           String   @id @default(uuid())
  snapshotJson String   @map("snapshot_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("schedule_backups")
}
