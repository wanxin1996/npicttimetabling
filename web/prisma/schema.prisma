generator client {
  // Generate the typed client outside the source tree so the app can import it cleanly.
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // The local prototype uses SQLite; the domain model remains portable to PostgreSQL later.
  provider = "sqlite"
}

model AppUser {
  // Reserved for the simple local-login feature planned after core scheduling is complete.
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("SCHEDULER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  // A teacher can be linked to imported allocations, generated course sections and blocked periods.
  id        String   @id @default(cuid())
  name      String   @unique
  staffType String   @default("FT")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations TeachingAllocation[]
  sections    CourseSection[]
  unavailable TeacherUnavailableWindow[]

  @@index([staffType, isActive])
}

model StudentGroup {
  // A student group is one class whose timetable must never overlap with itself.
  id        String   @id @default(cuid())
  code      String   @unique
  year      Int
  program   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections SectionStudentGroup[]

  @@index([year, program])
}

model Room {
  // Room facilities support requirement matching and the block supports travel warnings.
  id                String   @id @default(cuid())
  code              String   @unique
  block             String?
  capacity          Int
  hasMultiProjector Boolean  @default(false)
  isLab             Boolean  @default(false)
  isSmartClassroom  Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lessons ScheduledLesson[]

  @@index([block, isActive])
}

model Course {
  // A course defines shared teaching requirements; individual sections are created underneath it.
  id                     String   @id @default(cuid())
  code                   String   @unique
  durationHours          Int
  sessionsPerWeek        Int      @default(1)
  primaryYear            Int?
  minimumRoomCapacity    Int?
  requiresLab            Boolean  @default(false)
  requiresMultiProjector Boolean  @default(false)
  requiresSmartClassroom Boolean  @default(false)
  separateSectionsAcrossDays Boolean @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  allocations TeachingAllocation[]
  sections    CourseSection[]
}

model TeachingAllocation {
  // This records how many sections of one course a specific teacher is expected to teach.
  id                 String   @id @default(cuid())
  catalog            String?
  assignedGroupCount Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  courseId  String
  teacherId String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
}

model CourseSection {
  // A section is the draggable unit, for example LEAD_01, with one assigned teacher.
  id          String   @id @default(cuid())
  sequence    Int
  primaryYear Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId  String
  teacherId String?
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  studentGroups SectionStudentGroup[]
  lessons       ScheduledLesson[]

  @@unique([courseId, sequence])
  @@index([primaryYear])
  @@index([teacherId])
}

model SectionStudentGroup {
  // This join table supports both normal and cross-year classes in the same section.
  sectionId      String
  studentGroupId String

  section      CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup  @relation(fields: [studentGroupId], references: [id], onDelete: Cascade)

  @@id([sectionId, studentGroupId])
  @@index([studentGroupId])
}

model ScheduledLesson {
  // One section can meet multiple times each week and can use a different room per meeting.
  id            String   @id @default(cuid())
  occurrence    Int
  dayOfWeek     Int?
  startHour     Int?
  durationHours Int
  weekStart     Int?
  weekEnd       Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sectionId String
  roomId    String?
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  room      Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([sectionId, occurrence])
  @@index([roomId, dayOfWeek, startHour])
  @@index([dayOfWeek, startHour])
}

model TeacherUnavailableWindow {
  // A hard unavailable window is checked whenever a lesson is placed for this teacher.
  id        String   @id @default(cuid())
  dayOfWeek Int
  startHour Int
  endHour   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, dayOfWeek])
}

model YearBlockedWindow {
  // A year-level blocked window captures rules such as a Wednesday without classes.
  id        String   @id @default(cuid())
  year      Int
  dayOfWeek Int
  startHour Int
  endHour   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, dayOfWeek])
}

model RuleSetting {
  // Feature flags let future rule changes be enabled or disabled without deleting data.
  id        String   @id @default(cuid())
  key       String   @unique
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleBackup {
  // A serialized snapshot is kept before a new scheduling cycle replaces the old one.
  id           String   @id @default(cuid())
  snapshotJson String
  createdAt    DateTime @default(now())
}
