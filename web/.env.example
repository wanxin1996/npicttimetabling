# 应用实际读写的 SQLite 文件。测试时务必改成隔离数据库，不能指向生产文件。
TIMETABLING_DATABASE_PATH="./data/timetabling.db"

# Prisma 目前只用于 schema/迁移准备；应用 API 仍由 better-sqlite3 读取上面的路径。
DATABASE_URL="file:./prisma/dev.db"

# Railway 会自动注入挂载目录；本地开发不需要填写这一项。
# RAILWAY_VOLUME_MOUNT_PATH="/data"

# production 空库首次建立管理员时必须提供的高熵一次性令牌。
# 请在密码管理器中生成至少 32 bytes 的随机值，并只保存到 Railway Variables；
# 完成首位管理员初始化后可以删除或轮换，绝不能把真实值提交到 Git。
# TIMETABLING_SETUP_TOKEN="请替换为至少32-bytes的随机值"

# 线上部署检查的地址。也可以直接作为 verify:deployment 的命令参数传入。
# TIMETABLING_DEPLOYMENT_URL="https://你的域名.up.railway.app"

# 可选的线上验收账号。不要把真实密码提交到 Git。
# TIMETABLING_SMOKE_USERNAME="acceptance-user"
# TIMETABLING_SMOKE_PASSWORD="只保存在本地或平台密钥中"
